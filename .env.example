# Environment: development, production
NODE_ENV=development

# Server Port (REQUIRED - no fallback)
PORT=3001

# Base Path for subdirectory deployment (optional, leave empty for root)
# Example: BASE_PATH=/publicidad for dominio.com/publicidad
BASE_PATH=

# AWS S3 Configuration
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_PUBLIC=false
S3_SIGNED_EXPIRES=3600

# AWS Credentials (get from IAM user)
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Upload Limits (CRITICAL FOR PRODUCTION - must match Nginx client_max_body_size)
# Supported units: b, kb, mb, gb, tb (case-insensitive)
# For files > 100MB, use 200mb, 500mb, 1gb, etc.
UPLOAD_LIMIT=1gb
BODY_PARSER_LIMIT=1gb
RAW_BODY_LIMIT=1gb
# Admin Credentials (will move to database later)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SECRET=tu_secret_key_jwt_aqui

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tu_database_name
DB_USER=postgres
DB_PASSWORD=admin
DB_SSL=false

# Debug Logging
DEBUG=false
